{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OfficeGhost",
  "version": "0.1.0",
  "identifier": "com.officeghost.desktop",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "OfficeGhost",
        "width": 860,
        "height": 220,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 820,
        "minHeight": 200,
        "decorations": false,
        "alwaysOnTop": true,
        "maxWidth": 1300,
        "maxHeight": 760,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://updates.officeghost.com/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../rust-indexer/target/release"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
